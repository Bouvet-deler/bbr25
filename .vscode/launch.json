{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run game client (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/example_client/main.py",
            "cwd": "${workspaceFolder}/example_client",
            "python": "${workspaceFolder}/example_client/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}"
        }
    ]
}